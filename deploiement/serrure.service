[Unit]
Description=Serrure à frappes (application)
After=network.target

[Service]
Type=simple
User=raspi
WorkingDirectory=/home/raspi/projet-ul1in021-serrure
ExecStart=/home/raspi/projet-ul1in021-serrure/.venv/bin/python -m http.server 8000 --bind 127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
